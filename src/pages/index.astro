---
import { sanityClient } from "sanity:client";
// On utilise maintenant le nom explicite recommandé
import createImageUrlBuilder from '@sanity/image-url';

const builder = createImageUrlBuilder(sanityClient);
const urlFor = (source: any) => builder.image(source);

interface Movie {
  title: string;
  year: string;
  videoUrl: string;
  description: string;
  poster?: any; // Le "?" signifie que l'image est optionnelle
}

const movies = await sanityClient.fetch<Movie[]>(`*[_type == "movie"]{title, year, videoUrl, description, poster}`);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>Mon Portfolio Cinéma</title>
		<style>
			body { background: #0f172a; color: white; font-family: sans-serif; padding: 40px; }
			.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px; }
			.card { background: #1e293b; border-radius: 15px; overflow: hidden; border: 1px solid #334155; }
			.poster { width: 100%; height: 350px; object-fit: cover; background: #334155; }
			.placeholder { width: 100%; height: 350px; display: flex; align-items: center; justify-content: center; background: #0f172a; color: #475569; }
			.content { padding: 20px; }
			.btn { display: block; text-align: center; background: #38bdf8; color: #0f172a; padding: 10px; text-decoration: none; border-radius: 8px; font-weight: bold; margin-top: 15px; }
		</style>
	</head>
	<body>
		<h1>🎬 Mes Projets Cinéma</h1>
		<div class="grid">
			{movies.map((movie) => (
				<div class="card">
					{/* Si l'image existe, on l'affiche, sinon on met un carré gris */}
					{movie.poster ? (
						<img src={urlFor(movie.poster).width(600).url()} alt={movie.title} class="poster" />
					) : (
						<div class="placeholder">Pas d'affiche disponible</div>
					)}
					<div class="content">
						<h2>{movie.title}</h2>
						<p style="color: #38bdf8;">{movie.year}</p>
						<p>{movie.description}</p>
						<a href={movie.videoUrl} target="_blank" class="btn">Voir le projet</a>
					</div>
				</div>
			))}
		</div>
	</body>
</html>