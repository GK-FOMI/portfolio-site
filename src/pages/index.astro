---
import { sanityClient } from "sanity:client";
import createImageUrlBuilder from '@sanity/image-url';

const builder = createImageUrlBuilder(sanityClient);
const urlFor = (source: any) => builder.image(source);

// 1. On ajoute "role" dans l'interface pour supprimer l'erreur
interface Movie {
  title: string;
  year: string;
  role?: string; // Le "?" signifie qu'il peut être vide
  videoUrl: string;
  description: string;
  poster?: any;
}

// 2. On ajoute "role" dans la requête GROQ pour récupérer l'info
const movies = await sanityClient.fetch<Movie[]>(
  `*[_type == "movie"]{title, year, role, videoUrl, description, poster}`
);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>Mon Portfolio Cinéma</title>
		<style>
			/* Grille moderne type Netflix */
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
				gap: 40px;
				padding: 20px 0;
			}

			.card {
				position: relative;
				overflow: hidden;
				border-radius: 4px; /* Coins légèrement arrondis comme au ciné */
				transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
				cursor: pointer;
			}

			.card:hover {
				transform: scale(1.03); /* Léger zoom */
				z-index: 10;
			}

			.poster {
				width: 100%;
				aspect-ratio: 16/9; /* Format cinéma par défaut */
				object-fit: cover;
				filter: brightness(0.8);
				transition: filter 0.4s;
			}

			.card:hover .poster {
				filter: brightness(1); /* L'image s'éclaire au survol */
			}

			/* Overlay d'informations qui apparaît au survol */
			.overlay {
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				padding: 20px;
				background: linear-gradient(transparent, rgba(0,0,0,0.9));
				transform: translateY(20px);
				opacity: 0;
				transition: all 0.3s;
			}

			.card:hover .overlay {
				transform: translateY(0);
				opacity: 1;
			}
		</style>
	</head>
	<body>
		<h1>🎬 Mes Projets Cinéma</h1>
		<div class="grid">
			{movies.map((movie) => (
					<div class="card">
					{movie.poster && (
						<img src={urlFor(movie.poster).width(800).url()} alt={movie.title} class="poster" />
					)}
					<div class="overlay">
						<h2 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; margin:0;">{movie.title}</h2>
						<p style="color: #38bdf8; font-weight: bold; margin: 5px 0;">{movie.year} — {movie.role || "Réalisateur"}</p>
						<a href={movie.videoUrl} class="btn">VOIR LE FILM</a>
					</div>
				</div>
			))}
		</div>
	</body>
</html>