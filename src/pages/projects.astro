---
// 1. Les Imports
import MainLayout from '../layouts/MainLayout.astro';
import { sanityClient } from "sanity:client";
import createImageUrlBuilder from '@sanity/image-url';

// 2. Configuration des images Sanity
const builder = createImageUrlBuilder(sanityClient);
const urlFor = (source: any) => builder.image(source);

// 3. Définition de la structure d'un film
interface Movie {
  title: string;
  year: string;
  role?: string;
  videoUrl: string;
  description: string;
  poster?: any;
}

// 4. Récupération des données (Le moteur)
const movies = await sanityClient.fetch<Movie[]>(
  `*[_type == "movie"] | order(year desc) {title, year, role, videoUrl, description, poster}`
);
---

<MainLayout title="Mes Projets">
  <section class="container" style="padding: 60px 20px;">
    <h1 style="margin-bottom: 40px;">Mes Réalisations</h1>

    <div class="project-grid">
      {movies && movies.length > 0 ? (
        movies.map((movie) => (
          <div class="project-card">
            <div class="image-container">
              {movie.poster ? (
                <img 
                  src={urlFor(movie.poster).width(800).url()} 
                  alt={movie.title} 
                  class="project-poster" 
                />
              ) : (
                <div class="no-image">Image à venir</div>
              )}
              
              <div class="project-overlay">
                <div class="overlay-content">
                  <span class="project-year">{movie.year} — {movie.role || 'Réalisateur'}</span>
                  <h3>{movie.title}</h3>
                  <p>{movie.description}</p>
                  <a href={movie.videoUrl} target="_blank" class="btn-view">VOIR LE PROJET</a>
                </div>
              </div>
            </div>
          </div>
        ))
      ) : (
        <p style="color: #666;">Aucun projet publié pour le moment.</p>
      )}
    </div>
  </section>
</MainLayout>

<style>
  /* Design de la grille cinématique */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 30px;
  }

  .project-card {
    position: relative;
    background: #111;
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.4s ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
  }

  .image-container {
    position: relative;
    aspect-ratio: 16 / 9; /* Format cinéma classique */
    width: 100%;
  }

  .project-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    color: #444;
  }

  /* L'overlay sombre pour le texte */
  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 50%, transparent 100%);
    display: flex;
    align-items: flex-end;
    padding: 25px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .overlay-content h3 {
    margin: 5px 0;
    font-size: 1.5rem;
  }

  .project-year {
    font-size: 0.8rem;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .overlay-content p {
    font-size: 0.9rem;
    color: #ccc;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 15px;
  }

  .btn-view {
    font-size: 0.8rem;
    color: white;
    text-decoration: none;
    border: 1px solid white;
    padding: 8px 15px;
    transition: 0.3s;
  }

  .btn-view:hover {
    background: white;
    color: black;
  }
</style>