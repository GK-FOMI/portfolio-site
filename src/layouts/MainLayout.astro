---
const { title } = Astro.props;
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Panel — Portfolio Cinéma</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
    <style is:global>
      :root { --accent: #38bdf8; --bg: #050505; }
      body { background: var(--bg); color: white; font-family: 'Inter', sans-serif; margin: 0; line-height: 1.6; }
      nav { padding: 30px; display: flex; justify-content: center; gap: 40px; background: rgba(5,5,5,0.9); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 1000; }
      nav a { color: #888; text-decoration: none; font-size: 0.9rem; letter-spacing: 2px; text-transform: uppercase; transition: 0.3s; }
      nav a:hover, nav a.active { color: white; }
      .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
      h1, h2 { font-family: 'Playfair Display', serif; }
      .btn-primary { background: white; color: black; padding: 12px 25px; text-decoration: none; font-weight: bold; border-radius: 2px; transition: 0.3s; display: inline-block; }
      .btn-primary:hover { background: var(--accent); color: white; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Accueil</a>
      <a href="/projects">Projets</a>
      <a href="/cv">Parcours</a>
      <a href="/contact">Contact</a>
    </nav>
    <slot /> <footer style="text-align: center; padding: 60px; color: #444; font-size: 0.8rem;">
      © {new Date().getFullYear()} Gabriel — Étudiant en Cinéma
    </footer>
  </body>
</html>